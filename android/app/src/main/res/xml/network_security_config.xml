<?xml version="1.0" encoding="utf-8"?>
<!-- A interface conversa com o motor local em http://127.0.0.1 (nunca sai do celular). Com "Usar a IA de outro
     aparelho" ligado (a pessoa escolhe e digita o endereço), ela também fala com o PC da casa por http na rede local:
     por isso http é permitido. Os downloads (modelos, atualizações) continuam em https e conferidos por SHA-256. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
