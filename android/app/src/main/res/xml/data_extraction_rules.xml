<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: backup na nuvem e transferência entre aparelhos — só conversas e preferências (sem modelos, interface, logs e chave). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="dados" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="dados" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
